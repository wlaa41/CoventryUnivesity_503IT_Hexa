# Required for real Gmail OTP email through EmailJS
# EmailJS Dashboard → Account → API Keys → Public Key
VITE_EMAILJS_PUBLIC_KEY=your_emailjs_public_key_here

# Feedback-to-Gmail EmailJS template
VITE_EMAILJS_FEEDBACK_TEMPLATE_ID=your_feedback_template_id_here
VITE_FEEDBACK_TO_EMAIL=your_feedback_receiver_gmail_here
